# Care Navigator environment variables.
# Copy to .env and fill in only what you want to switch on.
# Every key is optional: leave it blank and that provider stays offline (D-008).
# Tests and `make eval` must pass with all keys blank.

# Claude (claude-haiku-5-5) for symptom extraction, follow-up question and explanation.
ANTHROPIC_API_KEY=

# Jev classifier (emergency check, category, urgency, vagueness, rerank, output guard).
# The HTTP request shape is unverified (D-022): check Jev's docs before setting this.
JEV_API_KEY=
# Jev endpoint. The default in config.py is a placeholder.
JEV_BASE_URL=

# Voyage embeddings for practitioner search (Phase 5). Offline TF-IDF is used when blank.
VOYAGE_API_KEY=
