# Care Navigator environment variables.
# Copy to .env and fill in only what you want to switch on.
# Every key is optional: leave it blank and that provider stays offline (D-008).
# Real environment variables override this file; blank values are ignored (D-024).
# Tests never read this file and always run offline.

# Claude (claude-haiku-5-5) for symptom extraction, follow-up question and explanation.
ANTHROPIC_API_KEY=

# TypeSafe Jev classifier (emergency check, category, urgency, vagueness, rerank, output guard).
JEV_API_KEY=
# Optional. Defaults: https://api.typesafe.ai/v1/systemone and jev-latest (D-023).
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Voyage embeddings for practitioner search (Phase 5). Offline TF-IDF is used when blank.
VOYAGE_API_KEY=
